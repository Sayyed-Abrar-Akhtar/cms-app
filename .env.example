# Database
MONGODB_URI="mongodb://localhost:27017/cms"

# Session Auth
SESSION_SECRET="super-secret-at-least-32-characters-long"

# Magic SDK (Passwordless Auth)
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY="pk_live_..."
MAGIC_SECRET_KEY="sk_live_..."

# Initial Superadmin
SUPERADMIN_EMAIL="admin@example.com"

# Cloudinary (Image Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend (Transactional Emails)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="CMS <cms@sayyedabrarakhtar.com.np>"

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
