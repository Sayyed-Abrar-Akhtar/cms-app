# MongoDB Atlas — a free M0 cluster is enough.
# Atlas → Database → Connect → Drivers → copy the connection string,
# fill in the user password, and point it at a database, e.g. ...mongodb.net/cms
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cms

# Session signing — any long random string.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Magic (passwordless email login) — https://dashboard.magic.link
# Publishable key is safe for the browser; the secret key is server-only.
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=pk_live_...
MAGIC_SECRET_KEY=sk_live_...

# Cloudinary (signed image uploads) — https://console.cloudinary.com
# Settings → API Keys. The secret must never reach the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder uploads land in (defaults to "cms-uploads").
CLOUDINARY_UPLOAD_FOLDER=cms-uploads

# Seed script (npm run seed) promotes this email to SUPERADMIN.
SUPERADMIN_EMAIL=you@example.com
