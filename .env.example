# MongoDB Atlas connection string (M0 free tier works fine)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cms?retryWrites=true&w=majority

# Auth & Session Configuration
# Generate a secret key (min 32 chars) for signing session JWT cookies
SESSION_SECRET=your_32_byte_random_string_here_1234567890
# Magic.link Auth keys (https://dashboard.magic.link)
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=pk_live_...
MAGIC_SECRET_KEY=sk_live_...

# Superadmin Seed Config
SUPERADMIN_EMAIL=admin@example.com

# Cloudinary CDN Configuration (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
